{
  "name": "Release Notes .NET 10",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/AzureDevOpsReleaseNotes",
  "shutdownAction": "stopCompose",
  "forwardPorts": [7071],
  "portsAttributes": {
    "7071": { "label": "Release Notes" }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-dotnettools.blazorwasm-companion",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "onCreateCommand": "sudo -n apt-get update && sudo -n apt-get install -y ripgrep",
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "postStartCommand": "bash .devcontainer/trust-cosmos-certificate.sh",
  "remoteUser": "vscode"
}
