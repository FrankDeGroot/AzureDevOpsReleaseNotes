{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/AzureDevOpsReleaseNotes",
  "shutdownAction": "stopCompose",
  "forwardPorts": [4280],
  "portsAttributes": {
    "4280": { "label": "Application" }
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azurestorage",
        "ms-azuretools.vscode-bicep",
        "ms-dotnettools.blazorwasm-companion",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-vscode.powershell"
      ]
    }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y ripgrep && gh --version",
  "postCreateCommand": "npm install -g --foreground-scripts @fission-ai/openspec@latest @azure/static-web-apps-cli azure-functions-core-tools@4 && func --version",
  "remoteUser": "vscode"
}
